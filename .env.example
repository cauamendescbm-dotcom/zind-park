# Copie para .env e preencha. Nada aqui vai para o GitHub (.env está no .gitignore).

# Como o atendimento responde:
#   auto    = hibrido se ANTHROPIC_API_KEY estiver preenchida, senão intents (padrão)
#   intents = só o chatbot de intenções (respostas oficiais, sem custo de IA)
#   hibrido = chatbot primeiro; o que ele não entender vai para o Claude
#   ia      = tudo pelo Claude
BOT_MODE=auto

# Claude (https://console.anthropic.com > API Keys). Opcional no modo intents.
ANTHROPIC_API_KEY=
# Mais barato: claude-haiku-4-5 (sem effort). Meio-termo: claude-sonnet-5-5.
CLAUDE_MODEL=claude-opus-5-5
# low = mais rápido e barato, bom para atendimento. Suba para medium se achar as respostas fracas.
CLAUDE_EFFORT=low

# Nome da atendente
AGENT_NAME=Ju

# WhatsApp Business Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha qualquer que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# App > Configurações > Básico > Chave secreta do app (confere que o webhook veio da Meta)
META_APP_SECRET=

# Instagram (developers.facebook.com > seu app > Messenger > Configurações do Instagram)
# A conta profissional precisa estar ligada a uma Página do Facebook.
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_TOKEN=
# Id da conta do Instagram (para ignorar mensagens enviadas pelo próprio Zind)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
# No Instagram o agente não atende festas: manda a pessoa para este link do WhatsApp
ZIND_WHATSAPP_LINK=https://wa.me/55DDDNUMERO

# "Comente PROMO" no Instagram: arquivo com as palavras e respostas
COMMENT_TRIGGERS_FILE=campanhas/comentarios-instagram.json
# Horas que o agente fica quieto quando alguém da equipe responde o cliente direto
HUMAN_PAUSE_HOURS=12

# Disparos: mensagens por segundo (a Meta libera 80/s por número no começo)
CAMPAIGN_RATE_PER_SECOND=50

# Organizadora: recebe os leads de festa e as dúvidas que o agente não souber (formato 5541999999999)
ORGANIZADORA_WHATSAPP=
# Templates aprovados na Meta (docs/templates-meta.md). Deixe vazio para mandar texto livre.
ORGANIZADORA_TEMPLATE_LEAD=
ORGANIZADORA_TEMPLATE_DUVIDA=
ORGANIZADORA_TEMPLATE_LANG=pt_BR

# Supabase > Project Settings > Database > Connection string (URI). Vazio = banco em memória.
DATABASE_URL=

# Humanização
TYPO_RATE=0.067
DEBOUNCE_MS=4000
HUMAN_DELAYS=true
