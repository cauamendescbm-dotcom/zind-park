# Copie para .env e preencha. Nada aqui vai para o GitHub (.env está no .gitignore).

# Claude (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = mais rápido e barato, bom para atendimento. Suba para medium se achar as respostas fracas.
CLAUDE_EFFORT=low

# Nome da atendente
AGENT_NAME=Ju

# WhatsApp Business Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha qualquer que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# App > Configurações > Básico > Chave secreta do app (confere que o webhook veio da Meta)
META_APP_SECRET=

# Organizadora: recebe os leads de festa e as dúvidas que o agente não souber (formato 5541999999999)
ORGANIZADORA_WHATSAPP=
# Templates aprovados na Meta (docs/templates-meta.md). Deixe vazio para mandar texto livre.
ORGANIZADORA_TEMPLATE_LEAD=
ORGANIZADORA_TEMPLATE_DUVIDA=
ORGANIZADORA_TEMPLATE_LANG=pt_BR

# Supabase > Project Settings > Database > Connection string (URI). Vazio = banco em memória.
DATABASE_URL=

# Humanização
TYPO_RATE=0.067
DEBOUNCE_MS=4000
HUMAN_DELAYS=true
